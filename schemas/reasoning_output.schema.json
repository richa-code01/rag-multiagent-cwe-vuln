{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/cwe-vuln/reasoning-output.schema.json",
  "title": "ReasoningAgentOutput",
  "description": "Assignment 4 structured output for the reasoning agent. Schema first in this assignment; template and Groq LLM reasoners landed later.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "decision",
    "cwe",
    "supporting_source_lines",
    "root_cause",
    "explanation",
    "remediation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["vulnerable", "not_vulnerable", "uncertain"]
    },
    "cwe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CWE-[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supporting_source_lines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "snippet"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "snippet": { "type": "string", "minLength": 1 }
      }
    },
    "root_cause": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 1 },
    "remediation": { "type": "string", "minLength": 1 },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
