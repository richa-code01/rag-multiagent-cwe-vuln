# Copy to `.env` in the repo root (gitignored). Never commit real keys.
#
# Tomorrow: export GROQ_API_KEY=gsk_...   (https://console.groq.com)
# CWE_VULN_LLM_API_KEY overrides GROQ_API_KEY if both are set.
# CWE_VULN_LLM_API_KEY=
# GROQ_API_KEY=
#
# Optional OpenAI-compatible settings
# CWE_VULN_LLM_MODEL=llama-3.1-8b-instant
# CWE_VULN_LLM_BASE_URL=https://api.groq.com/openai/v1
#
# MiniLM: first CLI retrieve/eval may download all-MiniLM-L6-v2 into .cache/
# CWE_VULN_SKIP_MINILM=1
# CWE_VULN_DOWNLOAD_MINILM=1
