# Required for `uv run cwe-vuln-pipeline` and `uv run cwe-vuln-eval --suite research`.
# Copy to `.env` in the repo root (gitignored). Never commit real keys.
#
# Provider is OpenAI-compatible chat-completions. Groq is the default (free-tier).
# Swap backends with CWE_VULN_LLM_PROVIDER — no code changes.
#
# CWE_VULN_LLM_PROVIDER=groq
# GROQ_API_KEY=
#
# CWE_VULN_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# CWE_VULN_LLM_MODEL=gpt-4o-mini
#
# CWE_VULN_LLM_PROVIDER=ollama
# CWE_VULN_LLM_MODEL=llama3.1
#
# Any other OpenAI-compatible host:
# CWE_VULN_LLM_PROVIDER=custom
# CWE_VULN_LLM_BASE_URL=https://api.example.com/v1
# CWE_VULN_LLM_MODEL=my-model
# CWE_VULN_LLM_API_KEY=
#
# CWE_VULN_LLM_API_KEY overrides the provider-specific key if both are set.
# CWE_VULN_LLM_JSON_MODE=0 disables response_format=json_object for hosts that reject it.
#
# Ablations (not the system of record):
#   uv run cwe-vuln-pipeline --offline
#   uv run cwe-vuln-eval --suite research --ablation template
#
# MiniLM: first CLI retrieve/eval may download all-MiniLM-L6-v2 into .cache/
# CWE_VULN_SKIP_MINILM=1
# CWE_VULN_DOWNLOAD_MINILM=1
